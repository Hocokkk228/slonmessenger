# Настройки сервера SLON. Скопируй в .env или задай как переменные окружения.
# Ничего из этого не обязательно — сервер заведётся и без единой настройки.

# Порт (по умолчанию 8080)
PORT=8080

# Куда класть базу slon.db (по умолчанию — рядом с server.js)
# DATA_DIR=/var/lib/slon

# Где лежит сайт (корень репозитория). По умолчанию — на два уровня выше server.js.
# WEB_DIR=/home/slon/slonmessenger

# TURN для звонков (без него звонки работают только при прямом соединении).
# Бесплатный вариант — ExpressTURN и т.п.
# TURN_URLS=turn:relay.example.com:3478
# TURN_USER=xxx
# TURN_PASS=yyy

# Пуши на Android (как в Telegram). JSON сервисного аккаунта Firebase одной строкой.
# Без него сообщения приходят, только пока приложение на связи.
# FCM_SA={"type":"service_account",...}

# Перенос старых аккаунтов из Firebase при первом входе (1 — да, 0 — выкл).
# На своём сервере, если Firebase недоступен, можно оставить 1 — просто не сработает.
FB_MIGRATE=1

# Список админов через запятую (могут сбрасывать пароли)
# ADMINS=mamedov,vadimslonik67
