{
  "appId": "com.sloncomp.slon",
  "appName": "SLON",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0d1520",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_slon",
      "iconColor": "#3390ec"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#0d1520",
      "style": "DARK"
    }
  }
}